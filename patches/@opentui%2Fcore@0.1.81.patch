+  _measureCellText(tokens) {
+    const chunks = [];
+    if (tokens) this.renderInlineContent(tokens, chunks);
+    const text = chunks.map(c => c.text).join("");
+    return Bun.stringWidth(text);
+  }
+  _computeColumnWidths(table, rowsToRender) {
+    const colCount = table.header.length;
+    const maxWidths = new Array(colCount).fill(0);
+    const minWidths = new Array(colCount).fill(0);
+    for (let col = 0; col < colCount; col++) {
+      const headerW = this._measureCellText(table.header[col].tokens) + 2;
+      let minCellW = headerW;
+      maxWidths[col] = headerW;
+      for (const row of rowsToRender) {
+        if (row[col]) {
+          const w = this._measureCellText(row[col].tokens) + 2;
+          maxWidths[col] = Math.max(maxWidths[col], w);
+          minCellW = Math.max(minCellW, Math.min(w, 20));
+        }
+      }
+      minWidths[col] = minCellW;
+    }
+    return { minWidths, maxWidths };
+  }
+  _styleHeaderChunks(chunks) {
+    const headingStyle = this.getStyle("markup.heading") || this.getStyle("default");
+    return chunks.map((chunk) => ({
+      ...chunk,
+      fg: headingStyle?.fg ?? chunk.fg,
+      bg: headingStyle?.bg ?? chunk.bg,
+      attributes: headingStyle ? createTextAttributes({
+        bold: headingStyle.bold,
+        italic: headingStyle.italic,
+        underline: headingStyle.underline,
+        dim: headingStyle.dim
+      }) : chunk.attributes
+    }));
+  }
+  _createTableRow(id, colCount, colSizes, cellDataArray, borderColor, showBottomBorder) {
+    const rowBox = new BoxRenderable(this.ctx, {
+      id,
+      flexDirection: "row",
+      alignItems: "stretch",
+      border: showBottomBorder ? ["bottom"] : false,
+      borderColor: showBottomBorder ? borderColor : undefined
+    });
+    for (let col = 0; col < colCount; col++) {
+      const cellBox = new BoxRenderable(this.ctx, {
+        id: `${id}-cell-${col}`,
+        flexDirection: "column",
+        flexGrow: colSizes.maxWidths[col],
+        flexShrink: 1,
+        flexBasis: colSizes.minWidths[col],
+        border: col > 0 ? ["left"] : false,
+        borderColor: col > 0 ? borderColor : undefined
+      });
+      cellBox.add(new TextRenderable(this.ctx, {
+        id: `${id}-cell-${col}-text`,
+        content: new StyledText(cellDataArray[col]),
+        wrapMode: "word",
+        paddingLeft: 1,
+        paddingRight: 1
+      }));
+      rowBox.add(cellBox);
+    }
+    return rowBox;
+  }
